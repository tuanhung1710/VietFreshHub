# bootstrap.sh generates the real, root-owned .env and .env.app on Ubuntu.
# Do not commit their real values.
APP_IMAGE=ghcr.io/tuanhung1710/vietfreshhub:REPLACE_WITH_FULL_COMMIT_SHA
SQL_IMAGE=REPLACE_WITH_EXISTING_SQL_IMAGE_DIGEST
SQL_VOLUME=vietfresh_sql_data
MSSQL_PID=Express
MSSQL_SA_PASSWORD=REPLACE_WITH_EXISTING_SA_PASSWORD
APP_DB_USER=vietfresh_app
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_APPLICATION_PASSWORD
PUBLIC_URL=http://192.168.250.130:8088
HTTP_PORT=8088
COOKIE_SECURE=false
VNPAY_ENABLED=false
